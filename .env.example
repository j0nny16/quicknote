# Copy to .env and fill in. Never commit .env.

# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (@userinfobot -> /start).
# Comma-separated. Anyone not listed is ignored silently.
ALLOWED_USER_IDS=

# console.anthropic.com
ANTHROPIC_API_KEY=

# From: docker compose exec anytype-cli anytype auth apikey create quicknotes
ANYTYPE_API_KEY=

# From: docker compose exec anytype-cli anytype space list
ANYTYPE_SPACE_ID=
